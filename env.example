# ============================================================================
# WCT Job Application Backend — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Azure Database for PostgreSQL (Flexible Server) connection ----
# These map 1:1 onto `pg`'s Pool config (see src/db.js).
PGHOST=your-server-name.postgres.database.azure.com
PGPORT=5432
PGDATABASE=wct_job_app
PGUSER=your_admin_user
PGPASSWORD=your_password_here

# Azure Postgres requires SSL. Leave this unset/"require" in every real
# environment. Only set to "disable" for a local Postgres instance that has
# no TLS configured (e.g. a docker-compose db for local dev) — never disable
# this against Azure.
PGSSLMODE=require

# ---- Auth / JWT ----
# Secret used to sign candidate session JWTs (src/routes/auth.js,
# src/middleware/auth.js). Use a long random value in real environments.
JWT_SECRET=change_me_to_a_long_random_string
# Candidate JWT lifetime, in a `ms`/jsonwebtoken-compatible string (e.g. "7d", "12h").
JWT_EXPIRES_IN=7d

# Secret used to sign admin session JWTs (see src/middleware/auth.js —
# deliberately a *different* secret from the candidate JWT_SECRET so a
# candidate token can never be replayed as an admin token or vice versa).
ADMIN_JWT_SECRET=change_me_to_a_different_long_random_string
ADMIN_JWT_EXPIRES_IN=12h

# Legacy break-glass admin passcode (spec §1.5 rpc_admin_login /
# admin_config table). Set a strong passcode here; src/routes/admin.js
# hashes+compares it against `admin_config.passcode_hash` (seeded manually,
# see the auth route's TODO) — NOT read directly as a live plaintext compare
# in production, this env var is only used by the one-time seeding step.
ADMIN_BREAK_GLASS_PASSCODE=

# ---- OAuth sign-in (Google + Microsoft) ----
# Both reuse the SAME existing, already-configured OAuth apps the original
# Supabase-based app used (product owner instruction, 2026-09-11) — no new
# app registration/OAuth client needed. This backend only ever needs each
# app's *client id* (to verify an ID token's `aud` claim, see
# src/lib/oauthVerify.js); no client secret is needed for ID-token
# verification itself.
#
# Microsoft (Entra) App Registration "WCT Job Application" — used for BOTH
# candidate Microsoft sign-in (POST /api/auth/oauth/microsoft) and admin
# Microsoft sign-in (POST /api/admin/auth/microsoft). Supported account types
# = "All Microsoft account users" (multi-tenant + personal), which is why
# oauthVerify.js validates against the multi-tenant issuer *pattern* rather
# than one fixed tenant.
# IMPORTANT: this app registration's redirect URI(s) must include wherever
# the new frontend actually gets deployed (Azure Static Web Apps), in
# addition to the original Supabase callback URL — add it in the Azure
# Portal under App registrations > WCT Job Application > Authentication.
MS_CLIENT_ID=4e5c255b-7d3d-4fca-b61d-bd506e50e09d

# Separate Azure app registration "WCT Admin" (as of 2026-09-14) used only
# for the admin dashboard's Microsoft sign-in (POST /api/admin/auth/microsoft,
# /api/admin/auth/session) — deliberately a different Azure app from
# MS_CLIENT_ID above, each with its own SPA redirect URI (login.html vs
# admin.html). Both are still required: candidate sign-in checks ID tokens
# against MS_CLIENT_ID, admin sign-in checks them against this one.
ADMIN_MS_CLIENT_ID=f776b1ef-50fd-4c76-88a1-c4e738392ac4

# Google Cloud OAuth 2.0 Web-application client "WCT Job Application"
# (project digitalize-job-application) — candidate Google sign-in only
# (POST /api/auth/oauth/google).
# IMPORTANT: this OAuth client's "Authorized JavaScript origins" must
# include wherever the new frontend actually gets deployed, in addition to
# the existing bqphua.github.io origin — add it in Google Cloud Console
# under APIs & Services > Credentials. Also note: as of 2026-09-11 this
# app's OAuth consent screen is still in "Testing" publishing status with
# an EMPTY test-user allowlist, meaning Google sign-in will not work for
# ANY account (not even a small pilot group) until either test users are
# added or the app is moved to "In production" (Google Auth Platform >
# Audience) — moving to production additionally requires filling in App
# name / Support email / Homepage URL / Privacy Policy URL on the Branding
# page first, which were still blank as of this writing.
GOOGLE_CLIENT_ID=805014615991-elic4o6auhe7m8fr6qmu24lhkd9eqarj.apps.googleusercontent.com

# Azure Blob Storage (spec §4) — file upload is now fully implemented (see
# src/routes/uploads.js), not a stub. The storage account and both
# containers already exist and only need a connection string here to be
# live:
#   Storage account: wctjobappstorage  (resource group wct-job-application-rg,
#     Southeast Asia, StorageV2/Standard_LRS, public blob access DISABLED —
#     both containers below are private; uploads.js hands back a read-only
#     SAS URL per file instead of a public URL, see that file's header
#     comment for why).
#   Containers: profile-pictures, attachments  (both already created).
#
# The connection string itself was NOT captured by the assistant that set
# this up — retrieving/printing a storage account key is treated as
# credential handling and was deliberately left for a human to do. Get it
# yourself via either:
#   Azure Portal: wctjobappstorage > Access keys > Connection string (key1)
#   Azure CLI:    az storage account show-connection-string \
#                   --name wctjobappstorage \
#                   --resource-group wct-job-application-rg
# then paste it below.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_PROFILE_PICTURES=profile-pictures
AZURE_STORAGE_CONTAINER_ATTACHMENTS=attachments

# ---- AI Insights (spec §8; see src/routes/aiInsights.js) ----
# Google Gemini API key. The original key was stored as a Supabase Edge
# Function secret and could NOT be recovered (Supabase only ever shows a
# SHA-256 digest of an already-set secret, never the plaintext) — generate a
# fresh key at https://aistudio.google.com/apikey and set it here.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.5-flash (matching the original).
# GEMINI_MODEL=gemini-3.5-flash

# ---- Frontend base URL, used to build deep links in notification payloads ----
# (e.g. "<FRONTEND_BASE_URL>/index.html?exit=<id>"). Point this at wherever
# the migrated frontend ends up deployed (Azure Static Web Apps). Defaults to
# the original app's GitHub Pages URL if unset.
FRONTEND_BASE_URL=https://bqphua.github.io/job-app

# ---- Power Automate notification webhooks (spec §9.4) ----
# Reverse-engineered from the original Supabase project's Postgres trigger/
# RPC functions (2026-09-11, at the product owner's direction) — see
# src/lib/powerAutomate.js for which event fires which URL. Each `sig=` query
# parameter is itself a bearer credential for that flow: treat every one of
# these 7 values as a secret exactly like a password. Leave unset in local/
# dev environments — notify() no-ops (with a one-time console warning) when
# the corresponding URL isn't configured.
# POWER_AUTOMATE_URL_SUBMIT=
# POWER_AUTOMATE_URL_STATUS_CHANGE=
# POWER_AUTOMATE_URL_BU_TRANSFER=
# POWER_AUTOMATE_URL_ONBOARDING_COMPLETE=
# POWER_AUTOMATE_URL_EXIT_INTERVIEW=
# POWER_AUTOMATE_URL_INVITE_ADMIN=
# POWER_AUTOMATE_URL_ADMIN_ACTIVE=
